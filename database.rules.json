{
  "rules": {
    ".read": false,
    ".write": false,
    "figoo_users": {
      ".read": "auth != null",
      "$ek": {
        ".read": true,
        ".write": true
      }
    },
    "figoo": {
      ".read": true,
      "$ek": {
        ".read": true,
        ".write": true
      },
